<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.womi.businessmodule.mapper.DeviceInfoMapper">
    <!-- ==================== 结果映射 ==================== -->
    <resultMap id="BaseResultMap" type="com.womi.businessmodule.model.DeviceInfo">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="device_id" property="deviceId" jdbcType="VARCHAR"/>
        <result column="device_name" property="deviceName" jdbcType="VARCHAR"/>
        <result column="location" property="location" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="uptime" property="uptime" jdbcType="BIGINT"/>
        <result column="last_heartbeat_time" property="lastHeartbeatTime" jdbcType="TIMESTAMP"/>
        <result column="last_update_time" property="lastUpdateTime" jdbcType="TIMESTAMP"/>
        <result column="last_payload" property="lastPayload" jdbcType="VARCHAR"/>
        <result column="sensor_data" property="sensorData" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>
    <!-- ==================== 基础字段 ==================== -->
    <sql id="Base_Column_List">
        id, device_id, device_name, location, status, uptime,
        last_heartbeat_time, last_update_time, last_payload, sensor_data,
        create_time, update_time
    </sql>
    <!-- ==================== 查询方法 ==================== -->
    <!-- 根据设备ID查询 -->
    <select id="selectByDeviceId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        WHERE device_id = #{deviceId}
    </select>
    <!-- 查询所有在线设备 -->
    <select id="selectOnlineDevices" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        WHERE status = 1
        ORDER BY last_heartbeat_time DESC
    </select>
    <!-- 根据设备名称模糊查询 -->
    <select id="selectByDeviceName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        WHERE device_name LIKE CONCAT('%', #{deviceName}, '%')
    </select>
    <!-- 根据状态查询设备列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        WHERE status = #{status}
        ORDER BY last_update_time DESC
    </select>
    <!-- 查询最近更新的设备 -->
    <select id="selectRecentDevices" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        ORDER BY last_update_time DESC
        LIMIT #{limit}
    </select>
    <!-- 查询离线设备（心跳超时） -->
    <select id="selectOfflineDevices" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM device_info
        WHERE status = 0
        OR last_heartbeat_time <![CDATA[ < ]]> DATE_SUB(NOW(), INTERVAL #{timeoutSeconds} SECOND)
    </select>
    <!-- 统计设备数量 -->
    <select id="countDevicesByStatus" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM device_info
        WHERE status = #{status}
    </select>
    <!-- ==================== 更新方法 ==================== -->
    <!-- 更新设备在线状态 -->
    <update id="updateStatus">
        UPDATE device_info
        SET status = #{status},
            last_heartbeat_time = #{heartbeatTime},
            last_update_time = #{updateTime}
        WHERE device_id = #{deviceId}
    </update>
    <!-- 更新设备信息 -->
    <update id="updateDeviceInfo">
        UPDATE device_info
        <set>
            <if test="deviceName != null and deviceName != ''">
                device_name = #{deviceName},
            </if>
            <if test="location != null and location != ''">
                location = #{location},
            </if>
            <if test="status != null">
            status = #{status},
        </if>
            <if test="uptime != null">
                uptime = #{uptime},
            </if>
            <if test="lastHeartbeatTime != null">
                last_heartbeat_time = #{lastHeartbeatTime},
            </if>
            <if test="lastPayload != null">
                last_payload = #{lastPayload},
            </if>
            <if test="sensorData != null">
                sensor_data = #{sensorData},
            </if>
            last_update_time = NOW()
        </set>
        WHERE device_id = #{deviceId}
    </update>
    <!-- 批量更新设备状态 -->
    <update id="batchUpdateStatus">
        UPDATE device_info
        SET status = #{status},
        last_update_time = NOW()
        WHERE device_id IN
        <foreach collection="deviceIds" item="deviceId" open="(" close=")" separator=",">
            #{deviceId}
        </foreach>
    </update>

    <!-- ==================== 插入方法 ==================== -->
    <insert id="insertOrUpdateDevice">
        INSERT INTO device_info (
            device_id, device_name, location, status, create_time, update_time
        ) VALUES (
                     #{deviceId}, #{deviceName}, #{location}, #{status}, NOW(), NOW()
                 )
        ON DUPLICATE KEY UPDATE
                             device_name = VALUES(device_name),
                             location = VALUES(location),
                             status = VALUES(status),
                             update_time = NOW()
    </insert>

    <!-- ==================== 删除方法 ==================== -->
    <!-- 删除设备 -->
    <delete id="deleteByDeviceId">
        DELETE FROM device_info
        WHERE device_id = #{deviceId}
    </delete>
    <!-- 批量删除设备 -->
    <delete id="batchDeleteDevices">
        DELETE FROM device_info
        WHERE device_id IN
        <foreach collection="deviceIds" item="deviceId" open="(" close=")" separator=",">
            #{deviceId}
        </foreach>
    </delete>

</mapper>